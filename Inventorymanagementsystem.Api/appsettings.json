{
  "ConnectionStrings": {
    "DefaultConnection": "Server=localhost,1433;Database=InventorymanagementsystemDb;User Id=sa;Password=YourPassword123!;TrustServerCertificate=True"
  },
  "JwtSettings": {
    "Key": "REPLACE_WITH_SECURE_256_BIT_SECRET_KEY_HERE",
    "Issuer": "Inventorymanagementsystem",
    "Audience": "InventorymanagementsystemClient",
    "ExpiresMinutes": 120
  },
  "Redis": {
    "ConnectionString": "localhost:6379"
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.Hosting.Lifetime": "Information"
      }
    },
    "WriteTo": [
      { "Name": "Console" },
      {
        "Name": "File",
        "Args": {
          "path": "logs/inventorymanagementsystem-.log",
          "rollingInterval": "Day"
        }
      }
    ]
  },
  "AllowedHosts": "*"
}
